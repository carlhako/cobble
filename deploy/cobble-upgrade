#!/usr/bin/python3
"""cobble upgrade helper — runs as root, triggered by cobble-upgrade.path.

cobble (unprivileged) asks for an upgrade by writing
/var/lib/cobble/upgrade/request.json containing {"tag": "vX.Y.Z", "request_id":
"<32 hex>"}. This helper:

  1. takes the request (renamed to request.processing so the path unit cannot
     retrigger) and treats it as untrusted: it is never followed through a
     symlink, must be a small regular file, and only a well-formed version tag
     and request id are accepted from it;
  2. looks up that tag's release in REPO (fixed at install time, never taken
     from the request);
  3. downloads the release's install.sh and cobble.tar.gz into a private root
     temp directory and verifies each against the sha256 digest GitHub publishes
     for the asset, failing closed if a digest is missing or differs;
  4. runs that release's installer in place (it restarts cobble);
  5. records the outcome in /var/lib/cobble-upgrade/status.json, a root-owned
     directory cobble can read but not write. Every status carries the
     request's id, so cobble never mistakes an earlier attempt's outcome for
     this one's.

Stdlib only, run by the system python3 — never the venv it is replacing.
Installed by install.sh to /usr/local/libexec/cobble/cobble-upgrade (root, 0755).
"""

from __future__ import annotations

import collections
import datetime
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

# install.sh rewrites this line with its REPO when it installs the helper.
REPO = "carlhako/cobble"

# The unit sets none of these; they exist so the test suite can run the helper
# unprivileged against a fake release server. Only root can edit the unit.
REQUEST_DIR = os.environ.get("COBBLE_UPGRADE_REQUEST_DIR", "/var/lib/cobble/upgrade")
STATUS_DIR = os.environ.get("COBBLE_UPGRADE_STATUS_DIR", "/var/lib/cobble-upgrade")
API_URL = os.environ.get("COBBLE_UPGRADE_API_URL", "https://api.github.com").rstrip("/")

TAG_RE = re.compile(r"^v[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}$")
REQUEST_ID_RE = re.compile(r"^[0-9a-f]{32}$")
# The installer colours its output; the tail is shown in the web interface.
ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
MAX_REQUEST_BYTES = 4096
MAX_ASSET_BYTES = 256 * 1024 * 1024
ASSETS = ("install.sh", "cobble.tar.gz")
LOG_TAIL_LINES = 200
HTTP_TIMEOUT = 60


class Rejected(Exception):
    """The request itself is unacceptable; nothing is downloaded. Carries the
    request's id when one could be read, so cobble can match the rejection."""

    def __init__(self, message: str, request_id: str | None = None) -> None:
        super().__init__(message)
        self.request_id = request_id


class Failed(Exception):
    """A well-formed request that could not be carried out."""


def now() -> str:
    return datetime.datetime.now(datetime.UTC).isoformat()


def log(msg: str) -> None:
    print(f"cobble-upgrade: {msg}", flush=True)


def write_status(**fields) -> None:
    os.makedirs(STATUS_DIR, mode=0o755, exist_ok=True)
    path = os.path.join(STATUS_DIR, "status.json")
    fd, tmp = tempfile.mkstemp(prefix=".status-", dir=STATUS_DIR)
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(fields, fh)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def take_request(request: str, processing: str) -> tuple[str, str]:
    """Move the request aside and return its (tag, request_id). Raises Rejected."""
    try:
        os.replace(request, processing)  # renames a symlink itself, never its target
    except OSError as exc:
        raise Rejected(f"request could not be taken ({exc.strerror})") from exc
    try:
        fd = os.open(processing, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:  # ELOOP: it is a symlink
        raise Rejected(f"request is not a regular file ({exc.strerror})") from exc
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Rejected("request is not a regular file")
        if st.st_size > MAX_REQUEST_BYTES:
            raise Rejected(f"request is larger than {MAX_REQUEST_BYTES} bytes")
        raw = os.read(fd, MAX_REQUEST_BYTES + 1)
    finally:
        os.close(fd)
    if len(raw) > MAX_REQUEST_BYTES:
        raise Rejected(f"request is larger than {MAX_REQUEST_BYTES} bytes")
    try:
        data = json.loads(raw)
    except ValueError as exc:
        raise Rejected("request is not valid JSON") from exc
    if not isinstance(data, dict):
        raise Rejected("request is not a JSON object")
    request_id = data.get("request_id")
    if not isinstance(request_id, str) or not REQUEST_ID_RE.fullmatch(request_id):
        raise Rejected("request does not carry a well-formed request id")
    tag = data.get("tag")
    if not isinstance(tag, str) or not TAG_RE.fullmatch(tag):
        raise Rejected("request does not name a well-formed release tag", request_id)
    return tag, request_id


def http_get(url: str, *, accept: str):
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "cobble-upgrade (+https://github.com/carlhako/cobble)",
            "Accept": accept,
        },
    )
    return urllib.request.urlopen(req, timeout=HTTP_TIMEOUT)


def release_assets(tag: str) -> dict[str, tuple[str, str]]:
    """{name: (download_url, sha256_hex)} for the assets the upgrade needs."""
    url = f"{API_URL}/repos/{REPO}/releases/tags/{tag}"
    try:
        with http_get(url, accept="application/vnd.github+json") as resp:
            release = json.load(resp)
    except urllib.error.HTTPError as exc:
        raise Failed(f"release {tag} could not be fetched from {REPO} (HTTP {exc.code})") from exc
    except (urllib.error.URLError, OSError, ValueError) as exc:
        raise Failed(f"release {tag} could not be fetched from {REPO}: {exc}") from exc
    if release.get("draft") or release.get("prerelease"):
        raise Failed(f"release {tag} is a draft or pre-release")
    found: dict[str, tuple[str, str]] = {}
    for asset in release.get("assets") or []:
        name = asset.get("name")
        if name not in ASSETS:
            continue
        digest = asset.get("digest") or ""
        if not digest.startswith("sha256:") or len(digest) != len("sha256:") + 64:
            raise Failed(f"release asset {name} has no published sha256 digest")
        found[name] = (asset.get("browser_download_url") or "", digest.split(":", 1)[1].lower())
    missing = [n for n in ASSETS if n not in found]
    if missing:
        raise Failed(f"release {tag} is missing {', '.join(missing)}")
    return found


def download_verified(url: str, expected_sha256: str, dest: str) -> None:
    scheme = API_URL.split(":", 1)[0]
    if not url.startswith(f"{scheme}://"):
        raise Failed(f"refusing to download from {url!r}")
    digest = hashlib.sha256()
    size = 0
    try:
        with http_get(url, accept="application/octet-stream") as resp, open(dest, "wb") as out:
            while chunk := resp.read(1024 * 1024):
                size += len(chunk)
                if size > MAX_ASSET_BYTES:
                    raise Failed(f"{os.path.basename(dest)} is larger than expected")
                digest.update(chunk)
                out.write(chunk)
    except (urllib.error.URLError, OSError) as exc:
        raise Failed(f"download of {os.path.basename(dest)} failed: {exc}") from exc
    if digest.hexdigest() != expected_sha256:
        raise Failed(f"{os.path.basename(dest)} does not match its published sha256 digest")


def run_installer(workdir: str, tag: str, tail: collections.deque) -> int:
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": "C.UTF-8",
        "COBBLE_TARBALL": os.path.join(workdir, "cobble.tar.gz"),
        "RELEASE_TAG": tag,
        "COBBLE_REPO": REPO,
    }
    proc = subprocess.Popen(
        ["bash", os.path.join(workdir, "install.sh")],
        cwd=workdir,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        errors="replace",
    )
    assert proc.stdout is not None
    for line in proc.stdout:
        sys.stdout.write(line)  # the full log goes to the journal
        sys.stdout.flush()
        tail.append(ANSI_RE.sub("", line.rstrip("\n")))
    return proc.wait()


def main() -> int:
    request = os.path.join(REQUEST_DIR, "request.json")
    processing = os.path.join(REQUEST_DIR, "request.processing")
    if not os.path.lexists(request):
        log("no upgrade request; nothing to do")
        return 0

    started = now()
    tag: str | None = None
    request_id: str | None = None
    tail: collections.deque[str] = collections.deque(maxlen=LOG_TAIL_LINES)
    workdir = tempfile.mkdtemp(prefix="cobble-upgrade-")  # 0700, root-owned
    try:
        tag, request_id = take_request(request, processing)
        log(f"upgrading cobble to {tag} from {REPO}")
        write_status(
            request_id=request_id,
            tag=tag,
            state="running",
            started_at=started,
            finished_at=None,
            exit_code=None,
            error=None,
            log_tail=None,
        )
        for name, (url, sha) in release_assets(tag).items():
            log(f"downloading {name}")
            download_verified(url, sha, os.path.join(workdir, name))
        log("checksums verified; running the installer")
        code = run_installer(workdir, tag, tail)
        if code != 0:
            raise Failed(f"the installer exited with status {code}")
        log(f"cobble {tag} installed")
        write_status(
            request_id=request_id,
            tag=tag,
            state="succeeded",
            started_at=started,
            finished_at=now(),
            exit_code=0,
            error=None,
            log_tail="\n".join(tail),
        )
        return 0
    except Rejected as exc:
        log(f"request rejected: {exc}")
        write_status(
            request_id=exc.request_id,
            tag=None,
            state="rejected",
            started_at=started,
            finished_at=now(),
            exit_code=None,
            error=str(exc),
            log_tail=None,
        )
        return 1
    except Exception as exc:  # Failed, or anything unexpected: never leave "running"
        log(f"upgrade failed: {exc}")
        write_status(
            request_id=request_id,
            tag=tag,
            state="failed",
            started_at=started,
            finished_at=now(),
            exit_code=None,
            error=str(exc),
            log_tail="\n".join(tail) or None,
        )
        return 1
    finally:
        shutil.rmtree(workdir, ignore_errors=True)
        remove_processing(processing)


def remove_processing(path: str) -> None:
    """Remove the taken request. lstat/unlink act on a link itself, never its
    target; anything that is not a file or link (a planted directory) is left."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return
    if stat.S_ISDIR(st.st_mode):
        log(f"leaving unexpected directory {path}")
        return
    os.unlink(path)


if __name__ == "__main__":
    sys.exit(main())
